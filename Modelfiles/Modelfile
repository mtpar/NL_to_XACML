	      ],
	"Condition.resources.logOp": <"and"|"or"|null>,

	"Condition.envNetworks": null | [<string>,<string>,...],
	"Condition.envNetworks.logOp": <"and"|"or"|null>,

	"Condition.envDatetimes": null | [<string>,<string>,...],
	"Condition.envDatetimes.logOp": <"and"|"or"|null>,

	"Condition.logOp": <"and"|"or"|null>,
	"Condition.particle": <"if" | "when" | "provided that" | "only if" | "unless" | ...>
  }

